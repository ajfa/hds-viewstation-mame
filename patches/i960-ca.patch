+uint32_t i960_cpu_device::sfr_r(int reg)
+{
+	// DMAC bit 31 is set by software and cleared by the DMA unit once it has taken effect
+	if(reg == 2)
+		return m_sfr[2] & ~0x80000000;
+	if(reg < 3)
+		return m_sfr[reg];
+	logerror("%x: read of undefined sf%d\n", m_PIP, reg);
+	return 0;
+}
+
+void i960_cpu_device::sfr_w(int reg, uint32_t data)
+{
+	if(reg < 3)
+		m_sfr[reg] = data;
+	else
+		logerror("%x: write of undefined sf%d = %08x\n", m_PIP, reg, data);
+	m_ca_irq_check = true;
+}
+
+void i960_cpu_device::ca_init(uint32_t prcb)
+{
+	m_PRCB = prcb;
+	for(int group = 0; group < 7; group++)
+		ca_load_ctrl(group);
+	m_AC = m_program.read_dword(m_PRCB + 8);
+	m_PC = 0x001f2002;
+	m_sfr[0] = m_sfr[1] = 0;
+
+	memset(m_r, 0, sizeof(m_r));
+	memset(m_rcache, 0, sizeof(m_rcache));
+	m_r[I960_FP] = int_stack();
+	m_r[I960_SP] = m_r[I960_FP] + 64;
+	m_rcache_pos = 0;
+	m_ca_irq_check = true;
+}
+
+void i960_cpu_device::ca_load_ctrl(int group)
+{
+	const uint32_t table = m_program.read_dword(m_PRCB + 4);
+	for(int i = 0; i < 4; i++)
+		m_ctrl[group * 4 + i] = m_program.read_dword(table + group * 16 + i * 4);
+	m_ca_irq_check = true;
+}
+
+void i960_cpu_device::ca_post_irq(int vector)
+{
+	const uint32_t int_tab = int_table();
+	const int priority = vector >> 3;
+	m_program.write_dword(int_tab, m_program.read_dword(int_tab) | (1 << priority));
+	const uint32_t word = int_tab + 4 + (vector >> 5) * 4;
+	m_program.write_dword(word, m_program.read_dword(word) | (1 << (vector & 31)));
+	m_ca_irq_check = true;
+}
+
+void i960_cpu_device::ca_check_irqs()
+{
+	const int cpu_pri = (m_PC >> 16) & 0x1f;
+	const uint32_t icon = m_ctrl[7];
+
+	// level-sensitive pins stay pending while they are held
+	for(int pin = 0; pin < 8; pin++)
+		if(BIT(m_xint_state, pin) && !BIT(icon, 2 + pin))
+			m_sfr[0] |= 1 << pin;
+
+	if(!BIT(icon, 10)) {
+		if((icon & 3) != 0)
+			logerror("interrupt controller mode %d not emulated\n", icon & 3);
+
+		int best = -1, best_vector = 0;
+		const uint32_t pend = m_sfr[0] & m_sfr[1];
+		for(int pin = 0; pin < 8; pin++) {
+			if(!BIT(pend, pin))
+				continue;
+			const int vector = (((m_ctrl[4 + pin / 4] >> ((pin & 3) * 4)) & 0xf) << 4) | 2;
+			if(best < 0 || vector > best_vector) {
+				best = pin;
+				best_vector = vector;
+			}
+		}
+		if(best >= 0) {
+			const int priority = best_vector >> 3;
+			if(priority > cpu_pri || priority == 31) {
+				m_sfr[0] &= ~(1 << best);
+				standard_irq_callback(best, m_IP);
+				take_interrupt(best_vector, priority);
+				return;
+			}
+		}
+	}
+
+	check_pending_irqs();
+}
+
+void i960_cpu_device::ca_sysctl(uint32_t src1, uint32_t src2, uint32_t src3)
+{
+	const int type = (src1 >> 8) & 0xff;
+	const int field1 = src1 & 0xff;
+	switch(type) {
+	case 0: // request interrupt
+		ca_post_irq(field1);
+		break;
+	case 1: // invalidate instruction cache
+	case 2: // configure instruction cache
+		break;
+	case 3: // reinitialize
+		m_IP = src2;
+		ca_init(src3);
+		break;
+	case 4: // load control registers
+		if(field1 < 7)
+			ca_load_ctrl(field1);
+		break;
+	default:
+		logerror("%x: sysctl %08x %08x %08x not emulated\n", m_PIP, src1, src2, src3);
+		break;
+	}
+}
+
+void i960_cpu_device::ca_calls(uint32_t num)
+{
+	const uint32_t table = m_program.read_dword(m_PRCB + 20);
+	const uint32_t entry = m_program.read_dword(table + 48 + num * 4);
+
+	if((entry & 3) == 2 && !(m_PC & 2)) {
+		// supervisor procedure called from user mode: switch to the supervisor stack
+		const uint32_t ssp = m_program.read_dword(table + 12);
+		do_call(entry & ~3, 2 | (m_PC & 1), ssp & ~3);
+		m_PC = (m_PC & ~1) | 2 | (ssp & 1);
+	}
+	else
+		do_call(entry & ~3, 0, m_r[I960_SP]);
+}
